# ============================================================
#  CertPortal — Environment Configuration
#  Copy this file to .env and fill in your values.
# ============================================================

# Flask secret key — CHANGE THIS in production (use: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-long-random-string

# ---------- LDAP ----------
LDAP_SERVER=ldap://your-ldap-server:389
LDAP_BASE_DN=dc=example,dc=com
LDAP_USER_DN=ou=users,dc=example,dc=com

# Service account used to search for users (leave blank for anonymous bind)
LDAP_BIND_DN=cn=ldap-reader,ou=service-accounts,dc=example,dc=com
LDAP_BIND_PASSWORD=service-account-password

# Search filter — {username} is substituted at runtime
LDAP_USER_SEARCH_FILTER=(uid={username})

# Group DNs — users must belong to one of these
LDAP_ADMIN_GROUP_DN=cn=cert-admins,ou=groups,dc=example,dc=com
LDAP_USER_GROUP_DN=cn=cert-users,ou=groups,dc=example,dc=com

# Set to 'true' to bypass LDAP and use LOCAL_USERS (dev/testing only)
LDAP_BYPASS=false

# Local users for testing — format: user:password:role (comma-separated)
# Roles: admin | user
LOCAL_USERS=admin:admin123:admin,jdoe:password:user

# ---------- CA Subject ----------
CA_COMMON_NAME=Company Internal CA
CA_ORGANIZATION=My Company Ltd
CA_ORG_UNIT=IT Security
CA_COUNTRY=US
CA_STATE=California
CA_LOCALITY=San Francisco

# ---------- Certificate Validity ----------
CA_VALIDITY_DAYS=3650
CLIENT_CERT_VALIDITY_DAYS=365
EXPIRY_WARNING_DAYS=30

# ---------- Paths ----------
CERTS_DIR=certs
DB_PATH=cert_manager.db
LOG_PATH=logs/app.log
LOG_LEVEL=INFO

# ---------- Flask ----------
FLASK_DEBUG=false

# Session lifetime in hours (default: 8)
SESSION_LIFETIME_HOURS=8

# Set to 'true' when serving over HTTPS (required in production).
# Set to 'false' only for local HTTP development.
SESSION_COOKIE_SECURE=true

# ---------- Email / Expiry Reminders ----------
# Set REMINDER_ENABLED=true and fill in SMTP_* to activate automatic reminders.
# The app sends one reminder email per threshold per certificate (no duplicates).
REMINDER_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=certportal@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=certportal@example.com
# Set to 'false' for plain SMTP (not recommended)
SMTP_USE_TLS=true
# Days before expiry that trigger a reminder email (comma-separated)
REMINDER_DAYS=30,7,1
# Full URL of this portal — included in reminder email links
PORTAL_URL=https://certportal.internal

# ---------- Cert Validity Options ----------
# Days shown in the admin Renew dropdown (comma-separated)
CERT_VALIDITY_OPTIONS=30,90,180,365,730

# ---------- Email Certificate Delivery ----------
# When true: generating a cert auto-emails the .p12 bundle (with password) to the user's
# LDAP email address. The portal download form is replaced by a "Resend" button.
# Requires SMTP_HOST and the user's LDAP account to have a mail attribute.
# Set to 'false' (default) to keep the manual download form.
CERT_EMAIL_DELIVERY=false
