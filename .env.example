# ============================================================
#  CertPortal — Environment Configuration
#  Copy this file to .env and fill in your values.
# ============================================================

# Flask secret key — CHANGE THIS in production (use: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-long-random-string

# ---------- LDAP ----------
LDAP_SERVER=ldap://your-ldap-server:389
LDAP_BASE_DN=dc=example,dc=com
LDAP_USER_DN=ou=users,dc=example,dc=com

# Service account used to search for users (leave blank for anonymous bind)
LDAP_BIND_DN=cn=ldap-reader,ou=service-accounts,dc=example,dc=com
LDAP_BIND_PASSWORD=service-account-password

# Search filter — {username} is substituted at runtime
LDAP_USER_SEARCH_FILTER=(uid={username})

# Group DNs — users must belong to one of these
LDAP_ADMIN_GROUP_DN=cn=cert-admins,ou=groups,dc=example,dc=com
LDAP_USER_GROUP_DN=cn=cert-users,ou=groups,dc=example,dc=com

# Set to 'true' to bypass LDAP and use LOCAL_USERS (dev/testing only)
LDAP_BYPASS=false

# Local users for testing — format: user:password:role (comma-separated)
# Roles: admin | user
LOCAL_USERS=admin:admin123:admin,jdoe:password:user

# ---------- CA Subject ----------
CA_COMMON_NAME=Company Internal CA
CA_ORGANIZATION=My Company Ltd
CA_ORG_UNIT=IT Security
CA_COUNTRY=US
CA_STATE=California
CA_LOCALITY=San Francisco

# ---------- Certificate Validity ----------
CA_VALIDITY_DAYS=3650
CLIENT_CERT_VALIDITY_DAYS=365
EXPIRY_WARNING_DAYS=30

# ---------- Paths ----------
CERTS_DIR=certs
DB_PATH=cert_manager.db
LOG_PATH=logs/app.log
LOG_LEVEL=INFO

# ---------- Flask ----------
FLASK_DEBUG=false
